# ---------------------------------------------------------------------------
# BOOKINGS BACKEND (Vercel serverless functions)
# ---------------------------------------------------------------------------

# Supabase — bookings are stored here in production.
# Create a table "bookings" (see SUPABASE_SCHEMA.md) and use the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BOOKINGS_TABLE=bookings

# Fallback when Supabase is not configured: bookings are written to
# ./data/bookings.json (local development only; not durable on Vercel).

# Admin dashboard password (protects /admin and the bookings API).
ADMIN_PASSWORD=
# Optional: set a long random string to sign admin session cookies.
ADMIN_SESSION_SECRET=

# Email delivery (optional). When both are set, each booking sends a
# confirmation to the family and a notification to the care team via Resend.
RESEND_API_KEY=
BOOKING_TO_EMAIL=
BOOKING_FROM_EMAIL=Arizona Development Center <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# GENERAL CONTACT FORM (legacy /contact page)
# ---------------------------------------------------------------------------

# Preferred: a form endpoint that accepts a JSON POST.
VITE_CONTACT_ENDPOINT=
# Fallback: opens a pre-filled email in the visitor's mail app.
VITE_CONTACT_EMAIL=
